# per-developer state
/.fo/
/.direnv/
/result
/result-*

# node
node_modules/

# PingIDM's own managed-object schema, extracted from the product image by
# `fo config export idm`. It is Ping's file, not this repo's, so it is not
# redistributed here -- run the export once and it appears. In your own
# project, where the object model IS yours, un-ignore it and commit it.
/platform/idm/conf/managed.json

# GENERATED by `fo build` from platform/typescript/. The TypeScript is the
# source; these are build output and must never be edited or reviewed.
/platform/idm/script/
/platform/idm/conf/endpoint-*.json
/platform/typescript/dist/
/platform/typescript/openapi/
/platform/typescript/.fo-ts-manifest.json

# per-developer Claude Code permissions
.claude/settings.local.json

# linked from the nix store by the devShell
/platform/typescript/node_modules
/platform/amster/config/realms/root/Scripts/
